{
  "name": "bradbit-editor",
  "private": true,
  "version": "0.1.0-alpha.4",
  "description": "Bradbit Editor — Agnostic creative writing text editor powered by Tauri v2, CodeMirror 6 and Rust",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "fetch:bradbit": "node scripts/fetch-bradbit.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.3",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "lucide": "^0.475.0",
    "marked": "^18.1.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
