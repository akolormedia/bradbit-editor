{
  "id": "guionista-kit",
  "name": "Screenwriting",
  "version": "1.0.0",
  "description": "Film, series and microdrama screenwriting kit with agents, commands, skills and a story bible.",
  "author": "Bradbit",
  "license": "MIT",
  "minimumBradbit": "0.1.0-alpha.2",
  "contributes": {
    "symbolSources": [
      {
        "id": "screenplay.characters",
        "language": "fountain",
        "kind": "character",
        "include": [
          "bible/characters/**/*.md"
        ],
        "name": "frontmatter.name",
        "aliases": [
          "frontmatter.aliases"
        ],
        "fallback": "heading"
      },
      {
        "id": "screenplay.locations",
        "language": "fountain",
        "kind": "location",
        "include": [
          "bible/locations/**/*.md"
        ],
        "name": "frontmatter.name",
        "aliases": [
          "frontmatter.aliases"
        ],
        "fallback": "heading"
      }
    ],
    "primaryPaths": [
      "script",
      "script/**"
    ]
  },
  "contents": [
    "AGENTS.md",
    ".bradbit/",
    "bible/",
    "structure/",
    "script/",
    "research/",
    "notes/",
    "README.md",
    "LICENSE"
  ]
}
